# ==========================================
# FORME E-Commerce Environment Configuration Template
# Do not commit real credentials or keys to Git.
# Copy this file to .env and adjust values for local development or production.
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# MongoDB Connection
# Local development default: mongodb://localhost:27017/forme_ecommerce
# Production Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/forme_ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/forme_ecommerce

# Authentication & Session Security
# Provide a strong random 64-character secret in production
JWT_SECRET=forme_super_secret_jwt_key_change_in_production_min64chars
COOKIE_SECRET=forme_cookie_signature_secret_change_in_production
SESSION_EXPIRY_DAYS=7

# Cloudinary Hosted Media Pipeline (Optional for local development, mandatory for cloud uploads)
CLOUDINARY_CLOUD_NAME=forme-store
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Bootstrap (Used by npm run seed:admin)
ADMIN_BOOTSTRAP_EMAIL=admin@forme-studio.com
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword2026!
ADMIN_BOOTSTRAP_NAME=FORME Lead Admin
